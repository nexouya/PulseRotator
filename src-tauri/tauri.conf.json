{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseRotator",
  "version": "0.1.1",
  "identifier": "com.nexuflux.pulserotator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PulseRotator - High Performance IP Rotator",
        "width": 900,
        "height": 720,
        "minWidth": 800,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mihomo"
    ],
    "resources": [
      "binaries/wintun.dll",
      "binaries/mihomo.exe",
      "binaries/mihomo-x86_64-pc-windows-msvc.exe"
    ]
  },
  "plugins": {
    "shell": {
      "sidecar": true,
      "scope": [
        {
          "name": "binaries/mihomo",
          "sidecar": true,
          "args": true
        }
      ]
    }
  }
}
